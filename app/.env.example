# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AI API Configuration (choose one or both)
# Groq API (recommended - fast and free, get key at https://console.groq.com)
VITE_GROQ_API_KEY=

# OpenRouter (fallback - has free models, get key at https://openrouter.ai)
VITE_OPENROUTER_API_KEY=

# Android push registration safety:
# Set true only after adding valid Firebase configuration (google-services.json).
VITE_ENABLE_PUSH_REGISTRATION=false
